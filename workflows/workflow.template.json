        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n   \"serviceName\":\"DatasetSP.save\",\n   \"requestBody\":{\n      \"entityName\":\"Parceiro\",\n      \"standAlone\":false,\n      \"fields\":[\n         \"CODPARC\",         \n         \"CODCID\",\n         \"NOMEPARC\",\n         \"RAZAOSOCIAL\",         \n         \"CGC_CPF\",\n         \"CODCTABCOINT\",\n         \"CLASSIFICMS\",\n         \"IDENTINSCESTAD\",\n         \"ATIVO\",\n         \"TIPPESSOA\",\n         \"EMAILNFE\",\n         \"OBSERVACOES\",\n         \"CEP\"\n      ],\n      \"records\":[\n         {\n            \"values\":{\n                \"1\":\"{{ $json.CODCID }}\",\n                \"2\":\"{{ $json[\"Razão Social\"] }}\",\n                \"3\":\"{{ $json[\"Razão Social\"] }}\",\n                \"4\":\"{{ $json.CNPJ }}\",\n                \"5\":\"{{ $json.CODCTABCOINT }}\",\n                \"6\":\"{{ $json.CLASSIFICMS }}\",\n                \"7\":\"{{ $json[\"Inscrição Estadual\"] }}\",\n                \"8\":\"S\",\n                \"9\":\"J\",\n                \"10\":\"{{ $json[\"EMAILNFE\"] }}\",\n                \"11\":\"{{ $json.OBSERVACOES }}\",\n                \"12\":\"{{ $json.CEP }}\"\n            }\n         }\n      ]\n   }\n}",
        "options": {}
